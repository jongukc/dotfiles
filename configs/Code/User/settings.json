                "workbench.action.newGroupRight"
            ]
        },
        {
            "before": [
                "<leader>",
                "t",
                "x"
            ],
            "commands": [
                "workbench.action.closeEditorsInGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "t",
                "n"
            ],
            "commands": [
                "workbench.action.focusNextGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "t",
                "p"
            ],
            "commands": [
                "workbench.action.focusPreviousGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "t"
            ],
            "commands": [
                "workbench.action.createTerminalEditorSameGroup"
            ]
        },
        {
            "before": [
                "<leader>",
                "l",
                "w"
            ],
            "commands": [
                "editor.action.toggleWordWrap"
            ]
        },
        {
            "before": [
                "<leader>",
                "d"
            ],
            "commands": [
                "editor.action.showHover"
            ]
        },
        {
            "before": [
                "<leader>",
                "q"
            ],
            "commands": [
                "code-telescope.fuzzy.diagnostics"
            ]
        },
        {
            "before": [
                "<leader>",
                "e"
            ],
            "commands": [
                "oil-code.open"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "n"
            ],
            "commands": [
                "editor.action.marker.nextInFiles"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "p"
            ],
            "commands": [
                "editor.action.marker.prevInFiles"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "h"
            ],
            "commands": [
                "workbench.action.openDocumentationUrl"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "k"
            ],
            "commands": [
                "code-telescope.fuzzy.keybindings"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "f"
            ],
            "commands": [
                "code-telescope.fuzzy.file"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "s"
            ],
            "commands": [
                "code-telescope.fuzzy.builtin"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "w"
            ],
            "commands": [
                {
                    "command": "workbench.action.findInFiles",
                    "args": {
                        "isRegex": false,
                        "isCaseSensitive": true,
                        "matchWholeWord": false
                    }
                }
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "g"
            ],
            "commands": [
                "code-telescope.fuzzy.wsText"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "d"
            ],
            "commands": [
                "code-telescope.fuzzy.diagnostics"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "r"
            ],
            "commands": [
                "code-telescope.fuzzy.resume"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "."
            ],
            "commands": [
                "workbench.action.openRecent"
            ]
        },
        {
            "before": [
                "<leader>",
                "/"
            ],
            "commands": [
                "code-telescope.fuzzy.fileText"
            ]
        },
        {
            "before": [
                "<leader>",
                "D"
            ],
            "commands": [
                "editor.action.goToTypeDefinition"
            ]
        },
        {
            "before": [
                "<leader>",
                "d",
                "s"
            ],
            "commands": [
                "code-telescope.fuzzy.documentSymbols"
            ]
        },
        {
            "before": [
                "<leader>",
                "w",
                "s"
            ],
            "commands": [
                "code-telescope.fuzzy.wsSymbols"
            ]
        },
        {
            "before": [
                "<leader>",
                "r",
                "n"
            ],
            "commands": [
                "editor.action.rename"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "a"
            ],
            "commands": [
                "editor.action.quickFix"
            ]
        },
        {
            "before": [
                "<leader>",
                "h",
                "p"
            ],
            "commands": [
                "editor.action.dirtydiff.next"
            ]
        },
        {
            "before": [
                "<leader>",
                "h",
                "b"
            ],
            "commands": [
                "git.blame.toggleEditorDecoration"
            ]
        },
        {
            "before": [
                "<leader>",
                "m"
            ],
            "commands": [
                "markdown.showPreview"
            ]
        },
        {
            "before": [
                "<leader>",
                "m",
                "s"
            ],
            "commands": [
                "markdown.showPreviewToSide"
            ]
        },
        {
            "before": [
                "<leader>",
                "t",
                "c"
            ],
            "commands": [
                "editor.action.toggleStickyScroll"
            ]
        },
        {
            "before": [
                "<leader>",
                "u"
            ],
            "commands": [
                "workbench.action.localHistory.restoreViaPicker"
            ]
        },
        {
            "before": [
                "<leader>",
                "n"
            ],
            "commands": [
                "editor.action.addSelectionToNextFindMatch"
            ]
        },
        {
            "before": [
                "<leader>",
                "p"
            ],
            "commands": [
                "editor.action.addSelectionToPreviousFindMatch"
            ]
        },
        {
            "before": [
                "<leader>",
                "t",
                "h"
            ],
            "commands": [
                {
                    "command": "workbench.action.openSettings",
                    "args": "editor.inlayHints.enabled"
                }
            ]
        },
        {
            "before": [
                "<leader>",
                "<leader>"
            ],
            "commands": [
                "code-telescope.fuzzy.recentFiles"
            ]
        },
        {
            "before": [
                "<leader>",
                "s",
                "/"
            ],
            "commands": [
                {
                    "command": "workbench.action.findInFiles",
                    "args": {
                        "onlyOpenEditors": true
                    }
                }
            ]
        },
        {
            "before": [
                "g",
                "d"
            ],
            "commands": [
                "editor.action.revealDefinition"
            ]
        },
        {
            "before": [
                "g",
                "r"
            ],
            "commands": [
                "code-telescope.fuzzy.lspRefs"
            ]
        },
        {
            "before": [
                "g",
                "I"
            ],
            "commands": [
                "editor.action.goToImplementation"
            ]
        },
        {
            "before": [
                "g",
                "D"
            ],
            "commands": [
                "editor.action.revealDeclaration"
            ]
        },
        {
            "before": [
                "[",
                "d"
            ],
            "commands": [
                "editor.action.marker.prevInFiles"
            ]
        },
        {
            "before": [
                "]",
                "d"
            ],
            "commands": [
                "editor.action.marker.nextInFiles"
            ]
        },
        {
            "before": [
                "[",
                "c"
            ],
            "commands": [
                "editor.action.focusStickyScroll"
            ]
        },
        {
            "before": [
                "<leader>",
                "?"
            ],
            "commands": [
                "whichkey.show"
            ]
        }
