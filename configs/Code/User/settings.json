    "git.blame.editorDecoration.enabled": true,
    "latex-workshop.latex.external.build.args": [
        "-C",
        "paper",
        "all"
    ],
    "latex-workshop.latex.external.build.command": "make",
    "latex-workshop.latex.autoBuild.run": "onSave",
    "[latex]": {
        "editor.defaultFormatter": "James-Yu.latex-workshop",
        "editor.defaultFoldingRangeProvider": "James-Yu.latex-workshop"
    },
    "editor.cursorStyle": "block",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "prettier.tabWidth": 4,
    "editor.autoIndent": "full",
    "editor.wrappingIndent": "indent",
    "editor.wordWrap": "on",
    "editor.scrollBeyondLastLine": false,
    "editor.cursorSurroundingLines": 4,
    "editor.cursorSurroundingLinesStyle": "default",
    "editor.renderLineHighlight": "line",
    "editor.renderWhitespace": "all",
    "editor.rulers": [
        80
    ],
    "editor.guides.indentation": true,
    "editor.stickyScroll.enabled": true,
    "editor.stickyScroll.maxLineCount": 3,
    "editor.occurrencesHighlight": "singleFile",
    "editor.colorDecorators": true,
    "editor.autoClosingBrackets": "languageDefined",
    "editor.autoClosingQuotes": "languageDefined",
    "editor.formatOnSave": true,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.suggestSelection": "first",
    "editor.wordBasedSuggestions": "matchingDocuments",
    "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
    "files.encoding": "utf8",
    "files.hotExit": "onExit",
    "workbench.editor.enablePreview": false,
    "workbench.editor.openSideBySideDirection": "right",
    "search.useIgnoreFiles": false,
    "search.exclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/.venv": true
    },
    "vim.timeout": 300,
    "vim.ignorecase": true,
    "vim.smartcase": true,
    "vim.hlsearch": false,
    "vim.incsearch": true,
    "vim.autoindent": true,
    "vim.whichwrap": "b,s,<,>,[,],h,l",
    "vim.textwidth": 80,
    "vim.cursorStylePerMode.normal": "block",
    "vim.cursorStylePerMode.insert": "block",
    "vim.cursorStylePerMode.replace": "block",
    "vim.cursorStylePerMode.visual": "block",
    "vim.visualModeKeyBindingsNonRecursive": [
        {
            "before": [
                "<Space>"
            ],
            "commands": [
                {
                    "command": "whichkey.show",
                    "args": [
                        {
                            "key": "c",
                            "name": "Code / Quickfix",
                            "type": "bindings",
                            "bindings": [
                                {
                                    "key": "a",
                                    "name": "quickFix",
                                    "type": "command",
                                    "command": "editor.action.quickFix"
                                }
                            ]
                        },
                        {
                            "key": "n",
                            "name": "addSelectionToNextFindMatch",
                            "type": "command",
                            "command": "editor.action.addSelectionToNextFindMatch"
                        },
                        {
                            "key": "p",
                            "name": "addSelectionToPreviousFindMatch",
                            "type": "command",
                            "command": "editor.action.addSelectionToPreviousFindMatch"
                        }
                    ]
                }
            ]
        },
        {
            "before": [
                "<"
            ],
            "after": [
                "<",
                "g",
                "v"
            ]
        },
        {
            "before": [
                ">"
            ],
            "after": [
                ">",
                "g",
                "v"
            ]
        },
        {
            "before": [
                "p"
            ],
            "after": [
                "\"",
                "_",
                "d",
                "P"
            ]
        },
        {
            "before": [
                "<leader>",
                "c",
                "a"
            ],
            "commands": [
                "editor.action.quickFix"
            ]
        },
        {
            "before": [
                "<leader>",
                "n"
            ],
            "commands": [
                "editor.action.addSelectionToNextFindMatch"
            ]
        },
        {
            "before": [
                "<leader>",
                "p"
            ],
            "commands": [
                "editor.action.addSelectionToPreviousFindMatch"
            ]
        },
        {
            "before": [
                "<leader>",
                "?"
            ],
            "commands": [
                {
                    "command": "whichkey.show",
                    "args": [
                        {
                            "key": "c",
                            "name": "Code / Quickfix",
                            "type": "bindings",
                            "bindings": [
                                {
                                    "key": "a",
                                    "name": "quickFix",
                                    "type": "command",
                                    "command": "editor.action.quickFix"
                                }
                            ]
                        },
                        {
                            "key": "n",
                            "name": "addSelectionToNextFindMatch",
                            "type": "command",
                            "command": "editor.action.addSelectionToNextFindMatch"
                        },
                        {
                            "key": "p",
                            "name": "addSelectionToPreviousFindMatch",
                            "type": "command",
                            "command": "editor.action.addSelectionToPreviousFindMatch"
                        }
                    ]
                }
            ]
        }
    ],
    "codeTelescope.keybindings": {
        "moveDown": "ctrl+j",
        "moveUp": "ctrl+k",
        "confirm": "enter",
        "close": "escape",
        "scrollUp": "ctrl+u",
        "scrollDown": "ctrl+d",
        "scrollLeft": "ctrl+h",
        "scrollRight": "ctrl+alt+l",
        "promptDelete": "backspace"
    },
    "codeTelescope.matching.algorithm": "subsequence",
    "codeTelescope.wsFileFinder.excludeHidden": false,
    "codeTelescope.wsFileFinder.excludePatterns": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.venv/**"
    ],
    "codeTelescope.wsTextFinder.excludePatterns": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.venv/**"
    ],
    "codeTelescope.preview.showLineNumbers": true,
    "codeTelescope.layout.mode": "classic",
    "codeTelescope.layout.promptFontSize": 18,
    "codeTelescope.layout.resultsFontSize": 18,
    "codeTelescope.layout.previewFontSize": 18,
    "oil-code.disableVimKeymaps": true,
    "oil-code.columns": [
        "permissions",
        "size",
        "mtime"
    ],
    "oil-code.enableWorkspaceEdit": true,
    "oil-code.hasNerdFont": false,
    "whichkey.delay": 0,
    "whichkey.sortOrder": "alphabetically",
    "lazygit-vscode.panels": {
        "sidebar": "hideRestore",
        "panel": "hideRestore",
        "secondarySidebar": "hideRestore"
    },
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--completion-style=detailed",
        "--function-arg-placeholders",
        "--fallback-style=llvm"
    ],
    "basedpyright.analysis.typeCheckingMode": "standard",
    "basedpyright.analysis.autoSearchPaths": true,
    "basedpyright.analysis.useLibraryCodeForTypes": true,
    "basedpyright.analysis.diagnosticMode": "openFilesOnly",
    "Lua.runtime.version": "LuaJIT",
    "Lua.diagnostics.globals": [
        "vim"
    ],
    "Lua.diagnostics.disable": [
        "missing-fields"
    ],
    "Lua.workspace.checkThirdParty": false,
    "Lua.completion.callSnippet": "Replace",
    "Lua.format.enable": false,
    "shellformat.flag": "-i 4",
    "shellformat.effectLanguages": [
        "shellscript"
    ],
    "todo-tree.highlights.enabled": true,
    "todo-tree.highlights.defaultHighlight": {
        "gutterIcon": false
    },
    "todo-tree.general.tags": [
        "TODO",
        "FIX",
        "FIXME",
        "BUG",
        "HACK",
        "WARN",
        "WARNING",
        "PERF",
        "NOTE",
        "TEST"
    ],
